%% generated by `orchestrate viz` -- do not hand-edit
graph LR
  subgraph AUTHORED_BY_SENDER["authored by the sender"]
    TEXT["message_text"]
    VOICE["voice transcript<br/>(IS the message)"]
  end
  subgraph AUTHORED_BY_OTHERS["authored by a third party"]
    IMG["text inside an image"]
    FWD["forwarded payload"]
  end
  INTENT["INTENT<br/>what the sender meant"]
  SAFETY["SAFETY<br/>is this dangerous"]

  TEXT --> INTENT
  TEXT --> SAFETY
  VOICE --> INTENT
  VOICE --> SAFETY
  IMG --> SAFETY
  FWD --> SAFETY
  IMG -. "BLOCKED" .-x INTENT
  FWD -. "BLOCKED" .-x INTENT

  class TEXT,VOICE det;
  class IMG,FWD model;
  class INTENT,SAFETY out;

  classDef det fill:#132b3a,stroke:#3d7ea6,color:#e8f2f7;
  classDef model fill:#3a2a13,stroke:#a67c3d,color:#f7f0e8;
  classDef gate fill:#2b1330,stroke:#8f4fa6,color:#f4e8f7;
  classDef out fill:#17331f,stroke:#3f8f52,color:#e6f2e9;
  classDef rej fill:#3b1d1d,stroke:#b04141,color:#f2e6e6;
  linkStyle 6,7 stroke:#b04141,stroke-width:2px;