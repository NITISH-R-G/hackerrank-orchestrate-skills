%% generated by `orchestrate viz` -- do not hand-edit
flowchart TD
  P(["proposal"]) --> M{"prior art<br/>in memory?"}
  M -- "rejected before" --> RC{"reconsideration<br/>condition met?"}
  RC -- no --> STOP["STOP<br/>blocked by prior art"]
  RC -- yes --> C
  M -- no --> C{"ceiling analysis<br/>rows this could fix"}
  C -- "0" --> STOP2["STOP<br/>no headroom"]
  C -- ">0" --> B["build the STRONGEST<br/>version of the idea"]
  B --> NEG{"negative control:<br/>break it on purpose --<br/>does the harness notice?"}
  NEG -- no --> FIX["the harness is broken.<br/>fix that first"]
  FIX --> NEG
  NEG -- yes --> MEAS["measure in the<br/>SHIPPED configuration"]
  MEAS --> D{"better on the<br/>metric you are graded on?"}
  D -- yes --> SHIP["ship + re-pin hash<br/>+ log cause/effect"]
  D -- no --> REJ["REJECT<br/>record the number<br/>+ reconsideration condition"]
  REJ --> KB[("Engineering Memory")]
  SHIP --> KB
  STOP --> KB
  STOP2 --> KB

  class STOP,STOP2,REJ,FIX rej;
  class SHIP,KB out;
  class NEG,MEAS,D,C,M,RC gate;

  classDef det fill:#132b3a,stroke:#3d7ea6,color:#e8f2f7;
  classDef model fill:#3a2a13,stroke:#a67c3d,color:#f7f0e8;
  classDef gate fill:#2b1330,stroke:#8f4fa6,color:#f4e8f7;
  classDef out fill:#17331f,stroke:#3f8f52,color:#e6f2e9;
  classDef rej fill:#3b1d1d,stroke:#b04141,color:#f2e6e6;